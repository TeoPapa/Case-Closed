      value: 
      objectReference: {fileID: -2176464878204383778, guid: 83a927f1098eb5b4383922ea48d9777f, type: 3}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[14].IsInCase
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[0].Description
      value: There's glass everywhere and in some places there is dirt too.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[1].Description
      value: A big clean house. It probably is probably worth quite a lot.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[2].Description
      value: One of the busiest roads in the city. The parking lot is located near
        there.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[3].Description
      value: There are boot marks that lead from Carol Street to Morning Street,
        right at the edge of Dean District.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[4].Description
      value: A lot of weird movement these days. A lot of hooded people around here.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[5].Description
      value: This is probably the schoolbag of a student
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[6].Description
      value: It has inside the money stolen from Johnathan
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[7].Description
      value: This bag has only trash inside.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[8].Description
      value: They stole my money. I kept them in my car hidden but someone stole
        them.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[9].Description
      value: ' I didn''t do anything. I swear, my sister Celia is innocent too. But
        I think Frank is shady.'
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[10].Description
      value: H- How can I help you detective?
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[11].Description
      value: Can I please go on with my day?
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[12].Description
      value: M- Me? No, I didn't do it. I-, okay, fine, I saw Hendrick holding a
        big brown bag in the park yesterday. I'm not sure why.
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[13].Description
      value: I didn't do anything detective, I swear!
      objectReference: {fileID: 0}
    - target: {fileID: 3876988909433394753, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: CaseList.Array.data[14].Description
      value: 'I cannot really deny it, can I? I needed the money from the job, but
        I didn''t stole them for me. '
      objectReference: {fileID: 0}
    - target: {fileID: 4552144494010031641, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: m_text
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4552144494010031641, guid: 66a4874a03cc566499a5025fc6b9eae3, type: 3}
      propertyPath: m_fontSize
      value: 70.15
      objectReference: {fileID: 0}
