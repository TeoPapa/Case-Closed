  Name: Drevin
  Dialogues:
  - Dialogues:
    - Name: '*'
      Answer: Hey, Drevin, can I help you?
    - Name: Drevin
      Answer: Yes, you can help me.
    - Name: Drevin
      Answer: Where are the cases I assigned to you?
    - Name: '*'
      Answer: Um...
    - Name: '*'
      Answer: I kinda forgot to get them done.
    - Name: Drevin
      Answer: You forgot?
    - Name: Drevin
      Answer: '*, we have quite the work in our hands, so please, get them done.'
    - Name: Drevin
      Answer: You may not leave until you're done!
    - Name: Drevin
      Answer: Okay boss!
  DestroyableObj: {fileID: 707280311}
  Enables: {fileID: 1635669882}
  Disables:
  - {fileID: 1886878480}
